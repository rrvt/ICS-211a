<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
  >

<Package UpgradeCode="D87FFC6C-9BE9-4670-BEFD-B35CB2F6FCD7" Language="1033"
  Manufacturer="Bob -- K6RWY" Name="ICS_211a"
  Version="!(bind.fileVersion.ICS_211a.cmp)" InstallerVersion="500"
  >

  <SummaryInformation Manufacturer="Bob -- K6RWY" Description="Installs ICS_211a"
    Comments="Copyright (c) Bob -- K6RWY"
    />

  <MajorUpgrade Schedule="afterInstallInitialize"
    AllowDowngrades="no" IgnoreRemoveFailure="no" AllowSameVersionUpgrades="no"
    DowngradeErrorMessage="A newer version of [ProductName] is already installed."
    />

  <MediaTemplate EmbedCab="yes" />

  <WixVariable Id="WixUILicenseRtf"
                                   Value="$(var.SolutionDir)..\..\Library\License\NoLicense.rtf" />
  <Property Id="LicenseAccepted" Value="1" />

  <Property Id="WIXUI_INSTALLDIR" Value="ICS_211A.PFF" />

  <UI Id="My_InstallDir.ui">
    <ui:WixUI Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </UI>

  <WixVariable Id="WixUIDialogBmp" Value="C:\Program Files (x86)\WixApp\dialog.bmp" />
  <WixVariable Id="WixUIBannerBmp" Value="C:\Program Files (x86)\WixApp\banner.bmp" />

  <Icon Id="ICS_211a_Icon.exe" SourceFile="$(var.SolutionDir)..\ICS_211a.prj\res\ICS_211a.ico" />
  <Property Id="ARPPRODUCTICON" Value="ICS_211a_Icon.exe" />

  <Feature Id="ProductFeatures" Title="Main Product" Level="1">
    <ComponentGroupRef Id="ICS_211a.ftr" />
    <ComponentGroupRef Id="Uninstall_ICS_211a.ftr" />
  </Feature>
</Package>

<Fragment>
  <ComponentGroup Id="ICS_211a.ftr">
    <ComponentRef Id="ICS_211a.cmp" />
    <ComponentRef Id="Help.cmp" />
  </ComponentGroup>
  <ComponentGroup Id="Uninstall_ICS_211a.ftr">
    <ComponentRef Id="Uninstall_ICS_211a.cmp" />
  </ComponentGroup>
</Fragment>

<!--Directory structure-->
<Fragment>
  <Property Id="ApplicationFolderName" Value="ICS_211a" />
  <Property Id="WixAppFolder"          Value="WixPerMachineFolder" />

  <StandardDirectory Id="ProgramFiles6432Folder">
    <Directory Id="ICS_211A.PFF" Name="ICS_211a" />
  </StandardDirectory>

  <StandardDirectory Id="ProgramMenuFolder">
    <Directory Id="ICS_211a.pmf" Name="ICS_211a" />
  </StandardDirectory>

  <StandardDirectory Id="DesktopFolder" />
</Fragment>

<Fragment>
  <Component Id="ICS_211a.cmp" Guid="BD5D97EF-49F3-497F-B54A-19F2B2D43E24"
                                                                          Directory="ICS_211A.PFF">
    <File Id="ICS_211a.cmp"
                  Source="$(var.ICS_211a.TargetDir)\..\Release.Win32\ICS_211a.exe" KeyPath="yes" />

    <Shortcut Id               = "ICS_211a.shc"
              Name             = "ICS_211a"
              Advertise        = "yes"
              Directory        = "ICS_211a.pmf"
              WorkingDirectory = "ICS_211A.PFF"
              Icon             = "ICS_211a_Icon.exe"
              />

    <Shortcut Id               = "ICS_211a.dsk"
              Name             = "ICS_211a"
              Advertise        = "yes"
              Directory        = "DesktopFolder"
              WorkingDirectory = "ICS_211A.PFF"
              Icon             = "ICS_211a_Icon.exe"
              />
  </Component>

  <Component Id="Help.cmp" Guid="92B2C4D7-991E-4F89-9D27-677480F2A9AE" Directory="ICS_211A.PFF">
    <File Id="Help.cmp"
                  Source="$(var.ICS_211a.TargetDir)\..\Release.Win32\ICS_211a.chm" KeyPath="yes" />
  </Component>
</Fragment>

<Fragment>
  <Component Id="Uninstall_ICS_211a.cmp"
                              Guid="678AC299-D0F6-474E-B45F-458771F698C2" Directory="ICS_211a.pmf">

    <Shortcut Id               = "UninstallICS_211a.shc"
              Name             = "Uninstall ICS_211a"
              Description      = "Uninstalls ICS_211a"
              Target           = "[System64Folder]msiexec.exe"
              Arguments        = "/x [ProductCode]"
              Icon             = "ICS_211a_Icon.exe"
              />
    <RemoveFolder Id="ICS_211a.uni" Directory="ICS_211a.pmf" On="uninstall" />
    <RegistryValue Root="HKCU" Key="Software\Uninstall_ICS_211a.cmp"
                                         Name="installed" Type="integer" Value="1" KeyPath="yes" />
  </Component>
</Fragment>
</Wix>
